# Copie este arquivo para .env e preencha com os dados do seu projeto no Supabase.
# O arquivo .env NUNCA vai para o GitHub.

# --- Banco de dados (Supabase › botão "Connect" › aba de connection string) ---
# Transaction pooler (porta 6543): usado pela API em tempo de execução
DATABASE_URL="postgresql://postgres.[ID-DO-PROJETO]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (porta 5432): usado pelo Prisma para criar e alterar tabelas (migrações)
DIRECT_URL="postgresql://postgres.[ID-DO-PROJETO]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

# --- Supabase (Project Settings › API) ---
NEXT_PUBLIC_SUPABASE_URL="https://[ID-DO-PROJETO].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[CHAVE-PUBLICA]"

# --- E-mail do convite (opcional) ---
# Chave SECRETA do Supabase (Project Settings › API Keys › Secret keys). Só a API usa.
# NUNCA coloque NEXT_PUBLIC_ na frente, não envie para o GitHub e não compartilhe.
# Sem ela, o convite funciona, mas nenhum e-mail é enviado.
SUPABASE_SECRET_KEY=""

# --- Busca de preços (opcional) ---
# Chave do SerpApi (serpapi.com › Dashboard › Your Private API Key). Só a API usa.
# Sem ela, o botão "Buscar preços" avisa que a busca não está configurada.
SERPAPI_KEY=""

# --- API ---
API_PORT=3333
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3333"
